{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM"],
        "baseUrl": ".",
        "paths": {
            "@components/*": ["resources/js/irep-admin/src/components/*"],
            "@/src/*": ["resources/js/irep-admin/src/*"],
            "@/types/*": ["resources/js/irep-admin/types/*"]
        }
    },
    "include": ["resources/js/**/*"],
    "exclude": ["node_modules", "resources/dist"]
}
